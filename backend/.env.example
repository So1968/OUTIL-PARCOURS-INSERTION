DATABASE_URL=postgresql://demo:demo@127.0.0.1:5432/artag_demo?schema=public
PORT=3101

# SSO désactivé tant que les habilitations et paramètres institutionnels ne sont pas validés.
ARTAG_OIDC_ENABLED=0
ARTAG_OIDC_ISSUER=
ARTAG_OIDC_CLIENT_ID=
ARTAG_OIDC_CLIENT_SECRET=
ARTAG_PUBLIC_ORIGIN=
ARTAG_OIDC_REDIRECT_URI=

# Écritures désactivées jusqu'à revue de sécurité et habilitations ARTAG.
ARTAG_ENABLE_SHARED_WRITES=0
ARTAG_CSRF_SECRET=

# Verrou supplémentaire de recette : toujours à 0 avant approbation ARTAG.
ARTAG_PRIVATE_RECIPE_GATE=0
ARTAG_ENABLE_WORK_TASKS=0

# Les flags ci-dessous appartiennent UNIQUEMENT à GitHub Actions et ne
# doivent jamais être configurés sur un serveur professionnel.
# ARTAG_DB_INTEGRATION_TEST=1
# ARTAG_RECOVERY_REHEARSAL=1
