// Modèle cible — aucune migration ni donnée réelle n'est créée automatiquement.
// Les permissions effectives doivent être vérifiées côté serveur et journalisées.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  REFERENTE
  APPUI_TNS
  ACCUEIL
  RELAIS_LOGEMENT
  DIRECTION
  GOUVERNANCE
  ADMIN_TECHNIQUE
}

enum CaseCapability {
  SHARED_READ
  SHARED_WRITE
  TNS_READ
  TNS_WRITE
  RESERVED_READ
  RESERVED_WRITE
}

enum ExternalSystem {
  INSERTIS
  MON_SUIVI_SOCIAL
  OUTLOOK
  ONEDRIVE
}

enum WorkTaskStatus {
  A_FAIRE
  EN_COURS
  EN_ATTENTE
  FAIT
}

// Repères de charge strictement personnels et sans nom de bénéficiaire.
enum WorkEventKind {
  IMPREVU
  APPEL
  RENDEZ_VOUS
  ENTRETIEN
  RELANCE
  ADMINISTRATIF
}

enum WorkEventState {
  PREVU
  EFFECTUE
  ANNULE
}

model UserAccount {
  id              String            @id @default(uuid())
  email           String            @unique
  role            AppRole
  enabled         Boolean           @default(false)
  createdAt       DateTime          @default(now())
  referentCases   CaseFile[]        @relation("ReferentCases")
  assignments     CaseAssignment[]
  grants          TemporaryGrant[]  @relation("GrantRecipient")
  approvedGrants  TemporaryGrant[]  @relation("GrantApprover")
  privateNotes    PrivateNote[]
  auditActions    AuditEvent[]
  webSessions     WebSession[]
  identityLinks   IdentityLink[]
  ownWorkTasks    WorkTask[]
  ownWorkEvents   WorkEvent[]
  sharedRevisions SharedNoteRevision[]
}

model CaseFile {
  id            String            @id @default(uuid())
  referentId    String?
  referent      UserAccount?      @relation("ReferentCases", fields: [referentId], references: [id], onDelete: SetNull)
  version       Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  archivedAt    DateTime?
  assignments   CaseAssignment[]
  grants        TemporaryGrant[]
  sharedNotes   SharedNote[]
  sharedRevisions SharedNoteRevision[]
  privateNotes  PrivateNote[]
  externalLinks ExternalLink[]
  auditEvents   AuditEvent[]
}

model CaseAssignment {
  id         String         @id @default(uuid())
  caseId     String
  userId     String
  capability CaseCapability
  active     Boolean        @default(false)
  caseFile   CaseFile       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user       UserAccount    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId, capability])
  @@index([userId])
}

model TemporaryGrant {
  id           String         @id @default(uuid())
  caseId       String
  userId       String
  approvedById String
  capability   CaseCapability
  reason       String         @db.VarChar(500)
  startsAt     DateTime
  expiresAt    DateTime
  revokedAt    DateTime?
  caseFile     CaseFile       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recipient    UserAccount    @relation("GrantRecipient", fields: [userId], references: [id], onDelete: Cascade)
  approver     UserAccount    @relation("GrantApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model SharedNote {
  id        String   @id @default(uuid())
  caseId    String
  text      String   @db.Text
  validated Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  caseFile  CaseFile @relation(fields: [caseId], references: [id], onDelete: Cascade)
  revisions SharedNoteRevision[]

  @@index([caseId])
}

// Chaque contenu partagé conservé constitue une version métier datée, attribuée,
// immuable au niveau du service. Sans accès HTTP direct ni export automatique.
model SharedNoteRevision {
  id          String      @id @default(uuid())
  noteId      String
  caseId      String
  version     Int
  text        String      @db.Text
  validated   Boolean     @default(false)
  actorId     String
  reason      String      @db.VarChar(200)
  createdAt   DateTime    @default(now())
  note        SharedNote  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  caseFile    CaseFile    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor       UserAccount @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([noteId, version])
  @@index([caseId, createdAt])
}

model PrivateNote {
  id        String      @id @default(uuid())
  caseId    String
  authorId  String
  text      String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  caseFile  CaseFile    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author    UserAccount @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseId, authorId])
}

model AuditEvent {
  id        String       @id @default(uuid())
  caseId    String?
  actorId   String?
  eventType String       @db.VarChar(100)
  purpose   String?      @db.VarChar(500)
  createdAt DateTime     @default(now())
  caseFile  CaseFile?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  actor     UserAccount? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
}

model ExternalLink {
  id          String         @id @default(uuid())
  caseId      String
  system      ExternalSystem
  externalRef String         @db.VarChar(255)
  enabled     Boolean        @default(false)
  createdAt   DateTime       @default(now())
  caseFile    CaseFile       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, system])
}

model IdentityLink {
  id        String      @id @default(uuid())
  userId    String
  issuer    String      @db.VarChar(512)
  subject   String      @db.VarChar(255)
  createdAt DateTime    @default(now())
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
}

model WebSession {
  id          String      @id @default(uuid())
  userId      String
  tokenDigest String      @unique @db.Char(64)
  createdAt   DateTime    @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OidcLoginAttempt {
  stateDigest String    @id @db.Char(64)
  verifier    String    @db.VarChar(255)
  nonce       String    @db.VarChar(255)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

// Tâches personnelles : aucun numéro de dossier ou note réservée dans ce modèle.
// L'accès dépend toujours de la session serveur et du propriétaire.
model WorkTask {
  id                 String         @id @default(uuid())
  requestId          String?        @db.VarChar(80)
  ownerId            String
  owner              UserAccount    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title              String         @db.VarChar(200)
  dueDate            DateTime?      @db.Date
  reminderDaysBefore Int            @default(1)
  snoozedUntil       DateTime?      @db.Date
  estimatedMinutes   Int?
  status             WorkTaskStatus @default(A_FAIRE)
  version            Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([ownerId, dueDate])
  @@index([ownerId, status])
  @@unique([ownerId, requestId])
}


// Saisie express privée : aucune description libre, aucun lien nominatif.
// La clé client unique évite les doubles créations lors d'un renvoi réseau.
model WorkEvent {
  id          String         @id @default(uuid())
  ownerId     String
  owner       UserAccount    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requestId   String         @db.VarChar(80)
  day         DateTime       @db.Date
  kind        WorkEventKind
  state       WorkEventState
  minutes     Int
  version     Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([ownerId, requestId])
  @@index([ownerId, day])
}
